# ~/jarvis/.credentials/assemblyai_key, outside this tree, on purpose.
*.key
*_key
.credentials/
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

